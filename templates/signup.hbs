<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign Up</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background: #f0f0f0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .signup-container {
      background: #fff;
      padding: 40px 30px;
      border-radius: 12px;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 360px;
      text-align: center;
      transform: scale(1);
      transition: transform 0.3s ease-in-out;
    }

    .signup-container:hover {
      transform: scale(1.05);
    }

    h2 {
      font-size: 28px;
      font-weight: 700;
      color: #333;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .signup-form {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .signup-field {
      margin-bottom: 20px;
      width: 100%;
    }

    .signup-input {
      width: 80%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      outline: none;
      transition: border-color 0.3s ease;
    }

    .signup-input:focus {
      border-color: #ff6f91;
    }

    .signup-button {
      width: 80%;
      padding: 12px;
      background-color: #ff6f91;
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .signup-button:hover {
      background-color: #f64f73;
    }
  </style>
</head>
<body>

  <div class="signup-container">
    <h2>Sign Up</h2>
    <form action="/signup" method="post" class="signup-form">
      <div class="signup-field">
        <input type="text" class="signup-input" name="name" placeholder="Username" required>
      </div>
      <div class="signup-field">
        <input type="email" class="signup-input" name="email" placeholder="Email" required>
      </div>
      <div class="signup-field">
        <input type="password" class="signup-input" name="password" placeholder="Password" required>
      </div>
      <button type="submit" class="signup-button">Create Account</button>
    </form>
  </div>

</body>
</html>
