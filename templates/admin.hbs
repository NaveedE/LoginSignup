<!DOCTYPE html>
<html lang="en">
<head>
  <style>
    .admin-body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #f5f7fa;
  padding: 40px;
}

.admin-container {
  max-width: 800px;
  margin: auto;
  background: #ffffff;
  padding: 30px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.admin-title {
  text-align: center;
  color: #333;
  margin-bottom: 25px;
  font-size: 2rem;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
}

.admin-table th,
.admin-table td {
  padding: 12px 15px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}

.admin-table th {
  background-color: #007bff;
  color: white;
}

.admin-table tr:nth-child(even) {
  background-color: #f2f2f2;
}

  </style>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="../public/login.css">
</head>
<body class="admin-body">
  <div class="admin-container">
    <h1 class="admin-title">Admin Dashboard</h1>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
          <tr>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</body>
</html>
